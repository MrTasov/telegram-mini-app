+    I18n.onChange(()=>{if(active){I18n.setAttr(el('mainMenuButtons'),'aria-label',I18n.t('menu.nav'));if(screen!=='home'){put(el('mainMenuTitle'),screen);put(el('mainMenuDescription'),screen+'.help');renderSlots();}}});
